# Copy to .env and fill in. NEVER commit .env.
DB_PATH=clinic.db
CLINIC_TZ=America/New_York

# Phase 2: shared secret Vapi sends with each tool call (leave blank for local dev)
VAPI_SECRET=

# Phase 2: only needed if you script Vapi setup via its API
VAPI_API_KEY=

# Phase 2: your public ngrok URL (changes each time ngrok restarts unless you use a static domain)
PUBLIC_URL=

# Set automatically by scripts/setup_vapi.py after the first run
VAPI_ASSISTANT_ID=

# Optional: a real phone number (E.164, e.g. +15551234567) for live transfers on phone calls
TRANSFER_PHONE_NUMBER=
